# General Configuration
RAILS_ENV=production
RAILS_MAX_THREADS=5

# Primary Database Configuration
PROD_PRIMARY_DATABASE=my_app_production
PROD_DB_USERNAME=prod_user
PROD_DB_PASSWORD=secure_password
PROD_DB_HOST=primary-db-host
PROD_DB_PORT=5432

# Replica Database Configuration
PROD_REPLICA_DATABASE=my_app_production_replica
PROD_REPLICA_USERNAME=prod_readonly_user
PROD_REPLICA_PASSWORD=secure_readonly_password
PROD_REPLICA_HOST=replica-db-host
PROD_REPLICA_PORT=5432

# Connection Pooling and Timeout
DB_POOL=10
DB_TIMEOUT=5000

# Development Database Configuration
DEV_DATABASE=my_app_development
DEV_DB_USERNAME=dev_user
DEV_DB_PASSWORD=dev_password
DEV_DB_HOST=localhost
DEV_DB_PORT=5432

# Test Database Configuration
TEST_DATABASE=my_app_test
TEST_DB_USERNAME=test_user
TEST_DB_PASSWORD=test_password
TEST_DB_HOST=localhost
TEST_DB_PORT=5432

REDIS_URL
DOMAIN
AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY
AWS_REGION
AWS_BUCKET
 